<% content_for :title, "Pull requests in #{@repo}" %>

<%= render layout: "shared/picker", locals: { page: "pulls", repositories: nil, query: nil } do %>
  <div class="z-10 border-b border-base-300 bg-base-200 max-md:sticky max-md:top-0">
    <div class="flex items-center gap-1 px-2 pt-2">
      <%= link_to repositories_path, class: "btn btn-ghost btn-sm gap-1.5 md:hidden" do %>
        <%= lucide_icon "arrow-left", class: "size-4", "aria-hidden": true %>
        Repositories
      <% end %>
      <h2 class="min-w-0 flex-1 truncate px-1 text-sm font-semibold md:px-2"><%= @repo %></h2>
      <%= link_to "https://github.com/#{@repo}/pulls", target: "_blank", rel: "noopener", class: "btn btn-ghost btn-square btn-sm shrink-0",
            "aria-label": "Open #{@repo} pull requests on GitHub" do %>
        <%= lucide_icon "external-link", class: "size-4", "aria-hidden": true %>
      <% end %>
    </div>

    <%= form_with url: pull_requests_path_for(@repo), method: :get, class: "p-3 pt-2",
          data: { turbo_frame: "pull_request_results", turbo_action: "replace", controller: "debounce-search", action: "input->debounce-search#submit" } do |form| %>
      <label class="input w-full">
        <%= lucide_icon "search", class: "size-4 opacity-50", "aria-hidden": true %>
        <%= form.search_field :q, value: @query, placeholder: "Search by title, #number or author",
              autocomplete: "off", class: "grow", "aria-label": "Search pull requests" %>
      </label>
    <% end %>
  </div>

  <%= turbo_frame_tag "pull_request_results", class: "block flex-1 overflow-x-hidden md:max-h-[32rem] md:overflow-y-auto",
        data: { loading_label: "Loading pull requests…" } do %>
    <% if @pull_requests.empty? %>
      <div class="flex flex-col items-center justify-center gap-3 p-10 text-center text-base-content/60">
        <%= lucide_icon "git-pull-request", class: "size-8 opacity-40", "aria-hidden": true %>
        <p><%= @query.present? ? "No open pull requests match “#{@query}”." : "#{@repo} has no open pull requests." %></p>
      </div>
    <% else %>
      <ul class="flex flex-col p-2" aria-label="Open pull requests in <%= @repo %>">
        <% @pull_requests.each do |pr| %>
          <% previous = @previous_verdicts[pr.number] %>
          <li>
            <%= form_with url: assessments_path_for(@repo, pr.number), class: "ask-jev group", data: { turbo_frame: "_top" } do %>
              <button type="submit" data-picker-item
                      class="flex w-full cursor-pointer items-center gap-3 rounded-field px-3 py-2.5 text-left transition-colors duration-150 hover:bg-base-200 focus-visible:bg-base-200">
                <span class="avatar shrink-0">
                  <span class="block size-8 overflow-hidden rounded-full bg-base-300">
                    <% if pr.author_avatar_url %><%= image_tag pr.author_avatar_url, alt: "", loading: "lazy" %><% end %>
                  </span>
                </span>

                <span class="min-w-0 flex-1">
                  <span class="block truncate font-medium"><%= pr.title %></span>
                  <span class="flex flex-wrap items-center gap-x-3 text-sm text-base-content/60">
                    <span class="tabular-nums">#<%= pr.number %></span>
                    <span><%= pr.author_login || "ghost" %>, updated <%= time_ago_in_words(pr.updated_at) %> ago</span>
                    <% if pr.draft %><span class="badge badge-ghost badge-sm">Draft</span><% end %>
                    <% if previous %>
                      <span class="inline-flex items-center gap-1.5">
                        <span class="status <%= previous.verdict[:status_class] %>" aria-hidden="true"></span>
                        Tagged <%= previous.verdict[:label].downcase %>
                      </span>
                    <% end %>
                  </span>
                </span>

                <span class="hidden shrink-0 text-sm tabular-nums sm:inline">
                  <span class="text-success">+<%= number_with_delimiter(pr.additions) %></span>
                  <span class="text-error">−<%= number_with_delimiter(pr.deletions) %></span>
                </span>

                <span class="shrink-0 text-right text-sm font-semibold sm:w-28">
                  <span class="hidden sm:inline group-aria-busy:hidden"><%= previous ? "Ask again" : "Ask Jev" %></span>
                  <%= lucide_icon "chevron-right", class: "size-4 opacity-50 sm:hidden group-aria-busy:hidden", "aria-hidden": true %>
                  <span class="hidden items-center justify-end gap-2 group-aria-busy:inline-flex">
                    <span class="loading loading-spinner loading-xs" aria-hidden="true"></span> Asking Jev
                  </span>
                </span>
              </button>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <div class="ask-jev-overlay" role="status" aria-live="polite">
    <div class="flex max-w-sm flex-col items-center text-center">
      <span class="loader-tag" aria-hidden="true"></span>
      <p class="mt-6 font-display text-2xl font-extrabold">Jev is reading the diff</p>
      <p class="mt-2 text-base-content/70">Deciding between a human review, an LLM review, or none. Big pull requests take a few seconds.</p>
      <div class="deciding mt-6" aria-hidden="true"><span></span><span></span><span></span></div>
    </div>
  </div>
<% end %>
