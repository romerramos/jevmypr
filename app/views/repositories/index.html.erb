<% content_for :title, "Repositories" %>

<%= render layout: "shared/picker", locals: {
      page: "repositories", repositories: @repositories, query: @query, pinned: @pinned, fetched_at: @fetched_at,
      title: "Choose a repository",
      intro: "Then pick one of its open pull requests. Jev reads the diff and tells you if it needs a human review." } do %>
  <div class="flex flex-1 flex-col items-center justify-center gap-3 p-10 text-center text-base-content/60">
    <%= lucide_icon "git-pull-request", class: "size-8 opacity-40", "aria-hidden": true %>
    <p>Choose a repository to see its open pull requests.</p>
  </div>

  <% if @recent_assessments.any? %>
    <div class="border-t border-base-300 p-4">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display font-bold">Recent verdicts</h2>
        <%= link_to "All verdicts", assessments_path, class: "link link-hover text-sm" %>
      </div>
      <div class="mt-2"><%= render "assessments/list", assessments: @recent_assessments %></div>
    </div>
  <% end %>
<% end %>
