<%= turbo_frame_tag "repositories", class: "block flex-1 overflow-x-hidden md:max-h-[32rem] md:overflow-y-auto" do %>
  <% if repositories.empty? %>
    <p class="p-6 text-center text-base-content/60">
      <%= query.present? ? "No repositories match “#{query}”." : "You don't have any repositories on GitHub yet." %>
    </p>
  <% else %>
    <ul class="menu w-full gap-0.5 p-2" aria-label="Repositories">
      <% repositories.each do |repo| %>
        <li>
          <%= link_to pull_requests_path_for(repo.full_name),
                class: "flex items-center gap-3 rounded-field py-2 text-base-content focus:text-base-content active:text-base-content aria-[current=page]:bg-base-300 aria-[current=page]:font-semibold",
                data: { turbo_frame: "_top", picker_item: true } do %>
            <span class="min-w-0 flex-1">
              <span class="block truncate">
                <span class="text-base-content/60"><%= repo.owner %>/</span><%= repo.name %>
              </span>
              <% if repo.pushed_at %>
                <span class="block text-xs font-normal text-base-content/50">pushed <%= time_ago_in_words(repo.pushed_at) %> ago</span>
              <% end %>
            </span>
            <% if repo.private %>
              <%= lucide_icon "lock", class: "size-3.5 shrink-0 opacity-50", "aria-label": "Private" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p class="border-t border-base-300 px-4 py-3 text-sm text-base-content/60">
    Missing a private or organization repository?
    <%= link_to "Review this app's access on GitHub", github_app_access_url, target: "_blank", rel: "noopener", class: "link", data: { turbo_frame: "_top" } %>
  </p>
<% end %>
