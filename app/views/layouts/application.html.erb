<!DOCTYPE html>
<html lang="en" data-controller="theme">
  <head>
    <meta charset="utf-8">
    <title><%= [ content_for(:title), "Jev my PR" ].compact_blank.join(" – ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="description" content="Pick a GitHub pull request and Jev tags it: human review, LLM review, or no review.">
    <meta name="application-name" content="Jev my PR">
    <meta name="apple-mobile-web-app-title" content="Jev my PR">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#FBFCFD" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#121922" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      try {
        const theme = localStorage.getItem("theme")
        if (theme) document.documentElement.dataset.theme = theme
      } catch (_) {}
    </script>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..900&family=Atkinson+Hyperlegible+Next:wght@400;500;700&display=swap">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex flex-col">
    <header class="border-b border-base-300">
      <nav class="navbar mx-auto max-w-6xl px-4 sm:px-6">
        <div class="navbar-start">
          <%= link_to root_path, class: "flex items-center gap-2 font-display text-lg font-extrabold", "aria-label": "Jev my PR home" do %>
            <%= image_tag "/icon.svg", alt: "", class: "size-7", "aria-hidden": true %>
            Jev my PR
          <% end %>
        </div>
        <div class="navbar-end gap-1">
          <button type="button" class="btn btn-ghost btn-square btn-sm" data-action="theme#toggle" aria-label="Switch colour theme">
            <%= lucide_icon "moon", class: "size-4 in-data-[theme=triage-night]:hidden", "aria-hidden": true %>
            <%= lucide_icon "sun-medium", class: "size-4 hidden in-data-[theme=triage-night]:block", "aria-hidden": true %>
          </button>
          <% if authenticated? %>
            <button type="button" class="btn btn-ghost btn-sm gap-2 px-1.5" popovertarget="account-menu" style="anchor-name: --account-menu" aria-label="Account menu">
              <span class="avatar">
                <span class="block size-7 overflow-hidden rounded-full bg-base-300">
                  <% if Current.user.avatar_url.present? %>
                    <%= image_tag Current.user.avatar_url, alt: "" %>
                  <% end %>
                </span>
              </span>
              <span class="hidden sm:inline"><%= Current.user.login %></span>
              <%= lucide_icon "chevron-down", class: "size-3.5 opacity-60", "aria-hidden": true %>
            </button>
            <ul class="dropdown dropdown-end menu mt-2 w-56 rounded-box border border-base-300 bg-base-100 p-2 shadow-lg" popover id="account-menu" style="position-anchor: --account-menu">
              <li class="menu-title">Signed in as <%= Current.user.login %></li>
              <li>
                <%= link_to "https://github.com/#{Current.user.login}", target: "_blank", rel: "noopener" do %>
                  <%= lucide_icon "external-link", class: "size-4", "aria-hidden": true %>
                  GitHub profile
                <% end %>
              </li>
              <li>
                <%= button_to session_path, method: :delete do %>
                  <%= lucide_icon "log-out", class: "size-4", "aria-hidden": true %>
                  Sign out
                <% end %>
              </li>
            </ul>
          <% end %>
        </div>
      </nav>
    </header>

    <% flash.each do |type, message| %>
      <div role="<%= type == "alert" ? "alert" : "status" %>" class="mx-auto mt-4 w-full max-w-6xl px-4 sm:px-6">
        <div class="alert <%= type == "alert" ? "alert-error" : "alert-info" %> alert-soft"><%= message %></div>
      </div>
    <% end %>

    <main class="mx-auto flex w-full max-w-6xl flex-1 flex-col px-4 py-10 sm:px-6">
      <%= yield %>
    </main>
  </body>
</html>
