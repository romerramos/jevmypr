<% verdict = @assessment.verdict %>
<% content_for :title, "#{verdict[:label]}: #{@assessment.repo_full_name} ##{@assessment.pr_number}" %>
<% back_url = pull_requests_path_for(@assessment.repo_full_name) %>

<div data-controller="hotkey" data-hotkey-key-value="Escape" data-hotkey-url-value="<%= back_url %>" data-action="keydown@window->hotkey#visit">
  <%= link_to back_url, class: "link link-hover inline-flex items-center gap-1.5 text-sm text-base-content/65" do %>
    <%= lucide_icon "arrow-left", class: "size-4", "aria-hidden": true %>
    Pull requests in <%= @assessment.repo_full_name %>
  <% end %>

  <section class="mt-6 grid items-start gap-14 md:grid-cols-[auto_minmax(0,1fr)] md:gap-12 lg:gap-20">
    <div class="triage-tag-stage max-md:hidden">
      <%= render "shared/triage_tag", verdict: @assessment.choice, tilt: "-4deg",
            fields: { repo: @assessment.repo_full_name, pr: "##{@assessment.pr_number}", title: @assessment.pr_title } %>
    </div>

    <div class="min-w-0">
      <p class="verdict-badge verdict-badge--<%= @assessment.choice %> mb-5 md:hidden">
        <%= lucide_icon verdict[:icon], class: "size-4", "aria-hidden": true %>
        <%= verdict[:label] %>
      </p>
      <h1 class="font-display text-4xl font-extrabold leading-[1.05] sm:text-5xl"><%= verdict[:headline] %></h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-content/75"><%= verdict[:summary] %></p>

      <dl class="mt-8 max-w-xl space-y-3" aria-label="How likely Jev thinks each option is">
        <% @assessment.ranked_probabilities.each do |key, option, probability| %>
          <div class="grid grid-cols-[8.5rem_minmax(0,1fr)_3.5rem] items-center gap-3 <%= "font-semibold" if key == @assessment.choice %>">
            <dt class="flex items-center gap-2 text-sm">
              <%= lucide_icon option[:icon], class: "size-4 opacity-70", "aria-hidden": true %>
              <%= option[:label] %>
            </dt>
            <dd class="contents">
              <progress class="progress h-2.5 <%= option[:progress_class] %>" value="<%= (probability * 100).round %>" max="100" aria-hidden="true"></progress>
              <span class="text-right text-sm tabular-nums"><%= number_to_percentage(probability * 100, precision: 0) %></span>
            </dd>
          </div>
        <% end %>
      </dl>

      <p class="mt-4 text-sm text-base-content/60">
        <% if @assessment.confidence %>Jev is <%= number_to_percentage(@assessment.confidence * 100, precision: 0) %> confident in this call.<% end %>
        Assessed <%= time_ago_in_words(@assessment.created_at) %> ago with <%= @assessment.jev_model %>.
      </p>

      <%#
        Phones: Open on GitHub full width, then Ask again and Another PR side by side.
        Wider screens: one row. Asking again is visible but deliberate (it uses Jev tokens).
      %>
      <div class="mt-8 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:items-center">
        <%= link_to "https://github.com/#{@assessment.repo_full_name}/pull/#{@assessment.pr_number}", target: "_blank", rel: "noopener", class: "btn btn-primary col-span-2" do %>
          <%= lucide_icon "external-link", class: "size-4", "aria-hidden": true %>
          Open on GitHub
        <% end %>
        <%= form_with url: assessments_path_for(@assessment.repo_full_name, @assessment.pr_number), class: "ask-jev", data: { turbo_frame: "_top" } do %>
          <button type="submit" class="btn btn-outline w-full" title="Ask Jev for a fresh verdict. Uses Jev tokens.">
            <%= lucide_icon "refresh-cw", class: "size-4", "aria-hidden": true %>
            <span class="sm:hidden">Ask again</span><span class="max-sm:hidden">Ask Jev again</span>
          </button>
        <% end %>
        <%= link_to back_url, class: "btn max-sm:btn-outline sm:btn-ghost" do %>
          <span class="sm:hidden">Another PR</span><span class="max-sm:hidden">Assess another PR</span>
          <kbd class="kbd kbd-sm max-sm:hidden">Esc</kbd>
        <% end %>
      </div>

      <%= render "feedbacks/feedback", assessment: @assessment %>

      <section class="mt-12 max-w-2xl" aria-labelledby="changed-files">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-base-300 pb-2">
          <h2 id="changed-files" class="font-display text-lg font-bold"><%= pluralize(@assessment.changed_files, "changed file") %></h2>
          <p class="text-sm tabular-nums">
            <span class="text-success">+<%= number_with_delimiter(@assessment.additions) %></span>
            <span class="text-error">−<%= number_with_delimiter(@assessment.deletions) %></span>
          </p>
        </div>

        <% if (counts = @assessment.file_verdict_counts).any? %>
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-base-content/70" aria-label="Files by verdict">
            <% counts.each do |_key, option, count| %>
              <span class="inline-flex items-center gap-1.5">
                <span class="status <%= option[:status_class] %>" aria-hidden="true"></span>
                <span class="tabular-nums"><%= count %></span> <%= option[:label] %>
              </span>
            <% end %>
          </p>
        <% end %>

        <%#
          Phones: the verdict sits on a second line under the filename. Wider screens: one row, verdicts in a column.
          The probabilities are in the title; the label is what matters.
        %>
        <ul class="mt-2 divide-y divide-base-300/70">
          <% @assessment.files_by_verdict.each do |file| %>
            <% icon = { "added" => "file-plus", "removed" => "file-minus" }.fetch(file["status"], "file-pen") %>
            <li class="grid grid-cols-[1rem_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 py-2 text-sm sm:grid-cols-[1rem_minmax(0,1fr)_auto_7.5rem]">
              <%= lucide_icon icon, class: "size-4 shrink-0 opacity-50", "aria-label": file["status"] %>
              <code class="min-w-0 break-all font-mono text-[0.8125rem]"><%= file["filename"] %></code>
              <span class="shrink-0 tabular-nums">
                <span class="text-success">+<%= file["additions"] %></span>
                <span class="text-error">−<%= file["deletions"] %></span>
              </span>
              <% if (option = PrAssessment::VERDICTS[file["choice"]]) %>
                <% odds = PrAssessment::VERDICTS.map { |key, o| "#{o[:label]} #{number_to_percentage(file.dig("probabilities", key).to_f * 100, precision: 0)}" } %>
                <span class="col-start-2 inline-flex items-center gap-1.5 text-base-content/75 sm:col-start-auto" title="<%= odds.join(" · ") %>">
                  <span class="status <%= option[:status_class] %>" aria-hidden="true"></span>
                  <%= option[:label] %>
                </span>
              <% elsif (skip = PrAssessment::FILE_SKIPS[file["skipped"]]) %>
                <span class="col-start-2 inline-flex items-center gap-1.5 text-base-content/50 sm:col-start-auto" title="<%= skip[:title] %>">
                  <span class="status status-neutral opacity-40" aria-hidden="true"></span>
                  <%= skip[:label] %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>

        <% if @assessment.diff_truncated %>
          <p class="mt-4 text-sm text-base-content/60">This diff is large, so Jev read 100 KB of it plus the full file list.</p>
        <% end %>
      </section>
    </div>
  </section>
</div>

<%= render "shared/ask_jev_overlay" %>
