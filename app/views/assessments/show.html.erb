<% verdict = @assessment.verdict %>
<% content_for :title, "#{verdict[:label]}: #{@assessment.repo_full_name} ##{@assessment.pr_number}" %>
<% back_url = root_path(repo: @assessment.repo_full_name) %>
<% file_limit = 40 %>

<div data-controller="hotkey" data-hotkey-key-value="Escape" data-hotkey-url-value="<%= back_url %>" data-action="keydown@window->hotkey#visit">
  <%= link_to back_url, class: "link link-hover inline-flex items-center gap-1.5 text-sm text-base-content/65" do %>
    <%= lucide_icon "arrow-left", class: "size-4", "aria-hidden": true %>
    Pull requests in <%= @assessment.repo_full_name %>
  <% end %>

  <section class="mt-6 grid items-start gap-14 md:grid-cols-[auto_minmax(0,1fr)] md:gap-20">
    <div class="order-2 flex justify-center pt-16 md:order-1 md:pt-20">
      <%= render "shared/triage_tag", verdict: @assessment.choice, tilt: "-4deg",
            fields: { repo: @assessment.repo_full_name, pr: "##{@assessment.pr_number}", title: @assessment.pr_title } %>
    </div>

    <div class="order-1 min-w-0 md:order-2">
      <h1 class="font-display text-4xl font-extrabold leading-[1.05] sm:text-5xl"><%= verdict[:headline] %></h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-content/75"><%= verdict[:summary] %></p>

      <dl class="mt-8 max-w-xl space-y-3" aria-label="How likely Jev thinks each option is">
        <% @assessment.ranked_probabilities.each do |key, option, probability| %>
          <div class="grid grid-cols-[8.5rem_minmax(0,1fr)_3.5rem] items-center gap-3 <%= "font-semibold" if key == @assessment.choice %>">
            <dt class="flex items-center gap-2 text-sm">
              <%= lucide_icon option[:icon], class: "size-4 opacity-70", "aria-hidden": true %>
              <%= option[:label] %>
            </dt>
            <dd class="contents">
              <progress class="progress h-2.5 <%= option[:progress_class] %>" value="<%= (probability * 100).round %>" max="100" aria-hidden="true"></progress>
              <span class="text-right text-sm tabular-nums"><%= number_to_percentage(probability * 100, precision: 0) %></span>
            </dd>
          </div>
        <% end %>
      </dl>

      <p class="mt-4 text-sm text-base-content/60">
        <% if @assessment.confidence %>Jev is <%= number_to_percentage(@assessment.confidence * 100, precision: 0) %> confident in this call.<% end %>
        Assessed <%= time_ago_in_words(@assessment.created_at) %> ago with <%= @assessment.jev_model %>.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <%= link_to @assessment.pr_url, target: "_blank", rel: "noopener", class: "btn btn-primary" do %>
          <%= lucide_icon "external-link", class: "size-4", "aria-hidden": true %>
          Open on GitHub
        <% end %>
        <%= link_to back_url, class: "btn btn-ghost" do %>
          Assess another PR <kbd class="kbd kbd-sm">Esc</kbd>
        <% end %>
      </div>

      <section class="mt-12 max-w-2xl" aria-labelledby="changed-files">
        <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-base-300 pb-2">
          <h2 id="changed-files" class="font-display text-lg font-bold"><%= pluralize(@assessment.changed_files, "changed file") %></h2>
          <p class="text-sm tabular-nums">
            <span class="text-success">+<%= number_with_delimiter(@assessment.additions) %></span>
            <span class="text-error">−<%= number_with_delimiter(@assessment.deletions) %></span>
          </p>
        </div>

        <ul class="divide-y divide-base-300/70">
          <% @assessment.files.first(file_limit).each do |file| %>
            <% icon = { "added" => "file-plus", "removed" => "file-minus" }.fetch(file["status"], "file-pen") %>
            <li class="flex items-center gap-3 py-2 text-sm">
              <%= lucide_icon icon, class: "size-4 shrink-0 opacity-50", "aria-label": file["status"] %>
              <code class="min-w-0 flex-1 truncate font-mono text-[0.8125rem]" title="<%= file["filename"] %>"><%= file["filename"] %></code>
              <span class="shrink-0 tabular-nums">
                <span class="text-success">+<%= file["additions"] %></span>
                <span class="text-error">−<%= file["deletions"] %></span>
              </span>
            </li>
          <% end %>
        </ul>

        <% if @assessment.files.size > file_limit %>
          <p class="mt-2 text-sm text-base-content/60">
            <%= link_to "#{@assessment.files.size - file_limit} more files on GitHub", "#{@assessment.pr_url}/files", class: "link", target: "_blank", rel: "noopener" %>
          </p>
        <% end %>

        <% if @assessment.diff_truncated %>
          <p class="mt-4 text-sm text-base-content/60">This diff is large, so Jev read the first 100 KB of it plus the full file list.</p>
        <% end %>
      </section>
    </div>
  </section>
</div>
