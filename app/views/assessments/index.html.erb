<% content_for :title, "Verdicts" %>
<% total = @counts.values.sum %>

<h1 class="font-display text-3xl font-extrabold sm:text-4xl">Verdicts</h1>
<% if @fetched_at %>
  <p class="mt-1 flex flex-wrap items-center gap-x-2 text-sm text-base-content/60">
    <span>Repository access checked <%= time_tag @fetched_at, short_time_ago(@fetched_at), title: l(@fetched_at, format: :long) %></span>
    <%= link_to assessments_path(q: @query.presence, verdict: @verdict, refresh: 1), class: "link inline-flex items-center gap-1",
          data: { turbo_prefetch: false }, title: "Check your repository access on GitHub again" do %>
      <%= lucide_icon "refresh-cw", class: "size-3.5", "aria-hidden": true %>Check again
    <% end %>
  </p>
<% end %>

<% if total.zero? %>
  <p class="mt-2 text-base-content/70">No saved verdicts in the repositories you can access yet.</p>
  <%= link_to "Pick a pull request", repositories_path, class: "btn btn-primary mt-6" %>
<% else %>
  <p class="mt-2 text-base-content/70">Shared repository verdicts and your private legacy history, newest first. Your votes stay private.</p>
  <% if @feedback.rated.positive? %>
    <p class="mt-3 flex flex-wrap items-center gap-x-2 text-sm text-base-content/70">
      <%= lucide_icon "thumbs-up", class: "size-4 opacity-70", "aria-hidden": true %>
      <span>You agreed with <%= @feedback.agreed %> of <%= pluralize(@feedback.rated, "verdict") %> you rated.</span>
      <% if @feedback.needed_more.positive? %><span><%= @feedback.needed_more %> needed more review than Jev said.</span><% end %>
      <% if @feedback.needed_less.positive? %><span><%= @feedback.needed_less %> needed less.</span><% end %>
    </p>
  <% end %>

  <%# Search and verdict filter are one form; results reload in the frame below. %>
  <%= form_with url: assessments_path, method: :get, class: "mt-6 max-w-3xl space-y-3",
        data: { turbo_frame: "verdicts", controller: "debounce-search",
                action: "input->debounce-search#submit change->debounce-search#submit turbo:submit-start@document->debounce-search#cancel" } do |form| %>
    <label class="input w-full">
      <%= lucide_icon "search", class: "size-4 opacity-50", "aria-hidden": true %>
      <%= form.search_field :q, value: @query, placeholder: "Search by title, repository or #number",
            autocomplete: "off", class: "grow", "aria-label": "Search verdicts" %>
    </label>

    <fieldset class="flex flex-wrap gap-2">
      <legend class="sr-only">Filter by verdict</legend>
      <% chips = [ [ "", "All", nil, total ] ] + PrAssessment::VERDICTS.map { |key, info| [ key, info[:label], info[:status_class], @counts[key].to_i ] } %>
      <% chips.each do |value, label, status_class, count| %>
        <label class="btn btn-sm rounded-full font-normal has-checked:border-base-content has-checked:bg-base-content has-checked:text-base-100 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-accent">
          <%= radio_button_tag :verdict, value, (@verdict || "") == value, class: "sr-only" %>
          <% if status_class %><span class="status <%= status_class %>" aria-hidden="true"></span><% end %>
          <%= label %>
          <span class="tabular-nums opacity-60"><%= count %></span>
        </label>
      <% end %>
    </fieldset>
  <% end %>

  <%= turbo_frame_tag "verdicts", class: "mt-4 block max-w-3xl", data: { loading_label: "Loading verdicts…" } do %>
    <% if @assessments.any? %>
      <div class="rounded-box border border-base-300 p-2">
        <%= render "assessments/list", assessments: @assessments %>
      </div>

      <% if @pagy.last > 1 %>
        <nav class="mt-4 flex items-center justify-between gap-3 text-sm" aria-label="Pagination">
          <p class="tabular-nums text-base-content/60"><%= @pagy.from %>–<%= @pagy.to %> of <%= @pagy.count %></p>
          <div class="join">
            <% if @pagy.previous %>
              <%= link_to @pagy.page_url(:previous), class: "btn btn-sm join-item", rel: "prev" do %>
                <%= lucide_icon "chevron-left", class: "size-4", "aria-hidden": true %> Newer
              <% end %>
            <% else %>
              <span class="btn btn-sm join-item btn-disabled" aria-disabled="true"><%= lucide_icon "chevron-left", class: "size-4", "aria-hidden": true %> Newer</span>
            <% end %>
            <% if @pagy.next %>
              <%= link_to @pagy.page_url(:next), class: "btn btn-sm join-item", rel: "next" do %>
                Older <%= lucide_icon "chevron-right", class: "size-4", "aria-hidden": true %>
              <% end %>
            <% else %>
              <span class="btn btn-sm join-item btn-disabled" aria-disabled="true">Older <%= lucide_icon "chevron-right", class: "size-4", "aria-hidden": true %></span>
            <% end %>
          </div>
        </nav>
      <% end %>
    <% else %>
      <div class="rounded-box border border-dashed border-base-300 p-8 text-center text-base-content/60">
        <p>No verdicts match<%= " “#{@query}”" if @query.present? %><%= " with #{PrAssessment::VERDICTS[@verdict][:label].downcase}" if @verdict %>.</p>
        <%= link_to "Show all verdicts", assessments_path, class: "link mt-2 inline-block", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  <% end %>
<% end %>
