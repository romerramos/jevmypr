<% content_for :title, "Your verdicts" %>

<h1 class="font-display text-3xl font-extrabold sm:text-4xl">Your verdicts</h1>

<% if @assessments.any? %>
  <p class="mt-2 text-base-content/70">Every pull request you asked Jev about, newest first.</p>
  <div class="mt-6 max-w-3xl rounded-box border border-base-300 p-2">
    <%= render "assessments/list", assessments: @assessments %>
  </div>
<% else %>
  <p class="mt-2 text-base-content/70">You haven't asked Jev about a pull request yet.</p>
  <%= link_to "Pick a pull request", repositories_path, class: "btn btn-primary mt-6" %>
<% end %>
