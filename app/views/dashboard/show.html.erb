<% content_for :title, "Pick a pull request" %>

<div data-controller="picker" data-action="keydown@window->picker#focusSearch keydown->picker#navigate">
  <h1 class="font-display text-3xl font-extrabold sm:text-4xl">Which PR should Jev triage?</h1>
  <p class="mt-2 text-base-content/70">Choose a repository, then a pull request. Jev reads the diff and tags it.</p>

  <section class="mt-8 grid grid-cols-[minmax(0,1fr)] overflow-hidden rounded-box border border-base-300 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <div class="flex min-h-80 flex-col border-base-300 max-md:border-b md:border-r" data-picker-pane>
      <%= form_with url: repositories_path, method: :get, class: "border-b border-base-300 bg-base-200/60 p-3",
            data: { turbo_frame: "repositories", controller: "debounce-search", action: "input->debounce-search#submit" } do |form| %>
        <%= form.hidden_field :repo, value: @repo %>
        <label class="input w-full">
          <%= lucide_icon "search", class: "size-4 opacity-50", "aria-hidden": true %>
          <%= form.search_field :q, placeholder: "Search repositories", autocomplete: "off", class: "grow",
                "aria-label": "Search repositories", data: { picker_target: "search" } %>
          <kbd class="kbd kbd-sm" title="Press / to search">/</kbd>
        </label>
      <% end %>

      <%= turbo_frame_tag "repositories", src: repositories_path(repo: @repo), class: "block max-h-[32rem] flex-1 overflow-x-hidden overflow-y-auto" do %>
        <%= render "shared/skeleton_rows", count: 6 %>
      <% end %>
    </div>

    <div class="flex min-h-80 flex-col" data-picker-pane>
      <%= turbo_frame_tag "pull_requests", src: (pull_requests_path(repo: @repo) if @repo), class: "flex flex-1 flex-col" do %>
        <% if @repo %>
          <%= render "shared/skeleton_rows", count: 5 %>
        <% else %>
          <div class="flex flex-1 flex-col items-center justify-center gap-3 p-10 text-center text-base-content/60">
            <%= lucide_icon "git-pull-request", class: "size-8 opacity-40", "aria-hidden": true %>
            <p>Choose a repository to see its open pull requests.</p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>

  <p class="mt-3 hidden gap-4 text-sm text-base-content/55 md:flex">
    <span><kbd class="kbd kbd-xs">/</kbd> search</span>
    <span><kbd class="kbd kbd-xs">↑</kbd> <kbd class="kbd kbd-xs">↓</kbd> move</span>
    <span><kbd class="kbd kbd-xs">Enter</kbd> open or ask Jev</span>
  </p>

  <% if @recent_assessments.any? %>
    <section class="mt-14">
      <h2 class="font-display text-xl font-bold">Your recent verdicts</h2>
      <ul class="list mt-3 rounded-box border border-base-300">
        <% @recent_assessments.each do |assessment| %>
          <li>
            <%= link_to assessment_path(assessment), class: "list-row items-center hover:bg-base-200 focus-visible:bg-base-200" do %>
              <span class="status status-md <%= assessment.verdict[:status_class] %>" aria-hidden="true"></span>
              <span class="min-w-0">
                <span class="block truncate font-medium"><%= assessment.pr_title %></span>
                <span class="block truncate text-sm text-base-content/60"><%= assessment.repo_full_name %> #<%= assessment.pr_number %></span>
              </span>
              <span class="text-sm text-base-content/70"><%= assessment.verdict[:label] %></span>
              <span class="hidden text-sm text-base-content/50 sm:inline"><%= time_ago_in_words(assessment.created_at) %> ago</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
