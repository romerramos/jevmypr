<%# Triage tag. Pass verdict: "yes" / "llm_enough" / "no" to tear off the strips below it; nil leaves a blank tag. %>
<% verdict = local_assigns[:verdict] %>
<% fields = local_assigns.fetch(:fields, {}) %>
<% strips = [
     { key: "yes", label: "Human review", tone: "red", icon: "user-round-check" },
     { key: "llm_enough", label: "LLM review", tone: "yellow", icon: "bot" },
     { key: "no", label: "No review", tone: "green", icon: "check" }
   ] %>
<% kept = verdict ? strips.index { |s| s[:key] == verdict } : strips.size - 1 %>

<figure class="triage-tag" style="--tag-tilt: <%= local_assigns.fetch(:tilt, "-3deg") %>" aria-label="<%= verdict ? "Triage tag: #{strips[kept][:label]}" : "Blank triage tag" %>">
  <svg class="triage-tag__string" viewBox="0 0 112 96" fill="none" aria-hidden="true">
    <path d="M56 92 C 40 60, 10 50, 4 0 M56 92 C 72 60, 102 50, 108 0" stroke="currentColor" stroke-width="1.5" />
  </svg>

  <div class="triage-tag__card">
    <span class="triage-tag__hole" aria-hidden="true"></span>

    <div class="triage-tag__body">
      <p class="font-display text-xl font-extrabold leading-tight">Pull request triage</p>

      <dl class="mt-3 text-sm">
        <% { "Repository" => fields[:repo], "Pull request" => fields[:pr], "Title" => fields[:title] }.each do |label, value| %>
          <div class="triage-tag__field">
            <dt class="text-xs opacity-60"><%= label %></dt>
            <dd class="min-h-5 truncate font-medium"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% strips.each_with_index do |strip, index| %>
      <% torn = index > kept %>
      <div class="triage-tag__strip triage-tag__strip--<%= strip[:tone] %> <%= "is-torn" if torn %>"
           style="--tear-order: <%= strips.size - 1 - index %>"
           <%= "aria-hidden=true" if torn %>>
        <span><%= strip[:label] %></span>
        <%= lucide_icon strip[:icon], class: "size-4", "aria-hidden": true %>
      </div>
    <% end %>
  </div>
</figure>
