#!/usr/bin/env ruby
# Updates this checkout to a release: the way a server moves between releases.
#
#   bin/update                 # the latest release
#   bin/update v0.2.0          # a specific release (also how you roll back)
#   bin/update --no-restart    # update, but leave the restart for later
#
# Always: fetches tags, checks out the release (a detached HEAD, which is normal for deploys), installs gems,
# runs migrations and precompiles assets (in production).
#
# On a server, config/server.yml (copy config/server.example.yml) makes it the whole deploy: it loads the app's
# environment, backs up the database first, restarts the app, waits until /up answers with the new version, and
# switches back to the previous release if it doesn't. See AGENTS.md → Deploying a release.
require_relative "../lib/release_update"

$stdout.sync = true # keep our lines in order with the commands' own output

restart = !ARGV.delete("--no-restart")
abort("Usage: bin/update [vX.Y.Z|latest] [--no-restart]") if ARGV.size > 1 || ARGV.first&.start_with?("-")

begin
  ReleaseUpdate.new(root: File.expand_path("..", __dir__), wanted: ARGV.first, restart: restart).call
rescue ReleaseUpdate::Failure => error
  abort("✗ #{error.message}")
end
